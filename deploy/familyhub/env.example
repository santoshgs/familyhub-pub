# Copy privately to .familyhub-local/deployment.env, never commit actual values.
# Hostname only, no protocol/path. Configure DNS and TLS before using real data.
FAMILYHUB_HOST=
POSTGRES_PASSWORD=
# Preserve existing JWT_SECRET and FAMILYHUB_TOKEN_KEY for recovered credentials.
JWT_SECRET=
TZ=America/New_York
REGISTRATION_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FAMILYHUB_GOOGLE_EMAIL=
FAMILYHUB_TOKEN_KEY=
# Sign in with Google (optional). Can reuse the Google OAuth client above: add
# https://<FAMILYHUB_HOST>/api/auth/oidc/callback as an authorized redirect URI.
# See docs/familyhub/GOOGLE_SIGNIN.md. Leave empty to keep password sign-in only.
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# After every household account has linked Google: false = Google only.
PASSWORD_LOGIN_ENABLED=true
