# Copy privately to .familyhub-local/deployment.env, never commit actual values.
# Hostname only, no protocol/path. Configure DNS and TLS before using real data.
FAMILYHUB_HOST=
POSTGRES_PASSWORD=
# Preserve existing JWT_SECRET and FAMILYHUB_TOKEN_KEY for recovered credentials.
JWT_SECRET=
TZ=America/New_York
REGISTRATION_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FAMILYHUB_GOOGLE_EMAIL=
FAMILYHUB_TOKEN_KEY=
# Account allowed to manage server credentials (Settings → Advanced). Empty =
# the first account created on this server.
FAMILYHUB_ADMIN_EMAIL=
